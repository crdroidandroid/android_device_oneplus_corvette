<resources>
    <!-- the padding on the start of the statusbar -->
    <dimen name="status_bar_padding_start">12dp</dimen>

    <!-- Location on the screen of the center of the physical power button. This is a reasonable
    default that should be overridden by device-specific overlays. -->
    <dimen name="physical_power_button_center_screen_location_y">1000px</dimen>

    <!-- Microns/ums (1000 um = 1mm) per pixel for the given device. If unspecified, UI that
         relies on this value will not be sized correctly. -->
    <item name="pixel_pitch" format="float" type="dimen">61.5</item>

    <!-- Udfps fingerprint animation -->
    <dimen name="udfps_animation_offset">-12dp</dimen>

    <!-- Tri-state UI -->
    <dimen name="tri_state_down_dialog_position">598.0px</dimen>
    <dimen name="tri_state_down_dialog_position_l">470.0px</dimen>
    <dimen name="tri_state_middle_dialog_position">428.0px</dimen>
    <dimen name="tri_state_middle_dialog_position_l">382.0px</dimen>
    <dimen name="tri_state_up_dialog_position">230.0px</dimen>
    <dimen name="tri_state_up_dialog_position_l">300.0px</dimen>
</resources>
